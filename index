
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070d17" />
  <title>CAPRI IA</title>
  <style>
    :root{
      --bg:#070d17;
      --bg-2:#0d1726;
      --sidebar:#0f1a2a;
      --panel:#121f30;
      --panel-strong:#182a3f;
      --panel-soft:#16263d;
      --blue:#39bfff;
      --cyan:#75e8ff;
      --purple:#8b7cff;
      --green:#42d392;
      --yellow:#ffc857;
      --danger:#ff647c;
      --text:#edf7ff;
      --muted:#8ea7bf;
      --border:#244160;
      --shadow: 0 24px 60px rgba(0,0,0,0.35);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      height: 100%;
      background:
        radial-gradient(circle at top left, rgba(57,191,255,0.13), transparent 25%),
        radial-gradient(circle at bottom right, rgba(139,124,255,0.12), transparent 30%),
        var(--bg);
      color: var(--text);
      font-family: Inter, "Segoe UI", Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      overflow: hidden;
    }

    button, input, textarea, select {
      font: inherit;
    }

    button {
      cursor: pointer;
      border: none;
      background: none;
      color: inherit;
    }

    button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 2px;
    }

    .app {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      height: 100vh;
      width: 100%;
    }

    .sidebar {
      background: rgba(15, 26, 42, 0.96);
      border-right: 1px solid var(--border);
      padding: 18px 18px 16px;
      display: flex;
      flex-direction: column;
      gap: 16px;
      backdrop-filter: blur(12px);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 6px 18px;
      border-bottom: 1px solid var(--border);
    }

    .logo-icon {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      display: grid;
      place-items: center;
      background: linear-gradient(135deg, rgba(57,191,255,0.18), rgba(117,232,255,0.06));
      border: 1px solid rgba(57,191,255,0.8);
      color: var(--cyan);
      font-size: 22px;
      font-weight: 900;
      box-shadow: 0 0 24px rgba(57,191,255,0.25);
    }

    .logo-text {
      line-height: 1.1;
    }

    .logo-text strong {
      display: block;
      letter-spacing: 3px;
      font-size: 17px;
      font-weight: 800;
    }

    .logo-text small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .nav-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .side-btn {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 12px;
      border-radius: 12px;
      color: var(--text);
      border: 1px solid transparent;
      background: transparent;
      text-align: left;
      transition: 0.2s ease;
    }

    .side-btn:hover {
      background: rgba(20, 38, 56, 0.8);
      border-color: rgba(57,191,255,0.2);
      transform: translateX(2px);
    }

    .side-btn.active {
      background: linear-gradient(180deg, rgba(26,44,63,0.9), rgba(15,28,41,0.9));
      border-color: rgba(57,191,255,0.5);
      box-shadow: inset 0 0 0 1px rgba(117,232,255,0.1);
    }

    .side-btn .left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.05);
      color: var(--cyan);
      font-size: 14px;
      font-weight: 700;
    }

    .badge {
      min-width: 24px;
      height: 24px;
      padding: 0 7px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(57,191,255,0.12);
      color: var(--cyan);
      font-size: 11px;
      font-weight: 700;
      border: 1px solid rgba(57,191,255,0.2);
    }

    .sidebar-label {
      margin: 10px 6px 4px;
      color: var(--muted);
      font-size: 10px;
      letter-spacing: 2.2px;
      text-transform: uppercase;
      font-weight: 700;
    }

    .sidebar-bottom {
      margin-top: auto;
      background: rgba(16, 26, 38, 0.9);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .status {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: var(--muted);
    }

    .status-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 16px rgba(66,211,146,0.8);
    }

    .main {
      display: flex;
      flex-direction: column;
      min-width: 0;
      height: 100vh;
      overflow: hidden;
    }

    .topbar {
      height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 18px 32px 16px;
      border-bottom: 1px solid var(--border);
      background: rgba(10, 17, 28, 0.45);
      backdrop-filter: blur(10px);
    }

    .topbar-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .title-wrap h1 {
      margin: 0;
      font-size: clamp(1.2rem, 2vw, 2rem);
      letter-spacing: 0.02em;
    }

    .title-wrap small {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 0.04em;
    }

    .topbar-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .ghost-btn, .primary-btn {
      border-radius: 12px;
      padding: 10px 16px;
      font-size: 14px;
      font-weight: 700;
      transition: 0.2s ease;
    }

    .ghost-btn {
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--border);
      color: var(--text);
    }

    .ghost-btn:hover {
      background: rgba(255,255,255,0.04);
    }

    .primary-btn {
      background: linear-gradient(135deg, var(--blue), var(--cyan));
      color: #04131d;
      box-shadow: 0 18px 25px rgba(57,191,255,0.2);
    }

    .primary-btn:hover {
      filter: brightness(1.06);
    }

    .content {
      flex: 1;
      overflow: auto;
      padding: 24px 30px 30px;
    }

    .hero {
      display: grid;
      grid-template-columns: 1.3fr 0.7fr;
      gap: 22px;
      margin-bottom: 24px;
    }

    .panel {
      background: linear-gradient(180deg, rgba(18,31,48,0.95), rgba(13,23,35,0.96));
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: var(--shadow);
    }

    .welcome {
      padding: 24px;
      position: relative;
      overflow: hidden;
    }

    .welcome::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(120deg, rgba(57,191,255,0.12), transparent 45%);
      pointer-events: none;
    }

    .welcome-header {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px;
      border-radius: 999px;
      background: rgba(57,191,255,0.10);
      border: 1px solid rgba(57,191,255,0.26);
      color: var(--cyan);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 800;
    }

    .welcome h2 {
      position: relative;
      z-index: 1;
      margin: 0 0 12px;
      font-size: clamp(1.6rem, 2.6vw, 2.6rem);
      letter-spacing: -0.04em;
    }

    .welcome p {
      position: relative;
      z-index: 1;
      margin: 0;
      max-width: 52ch;
      color: var(--muted);
      line-height: 1.7;
      font-size: 15px;
    }

    .welcome-actions {
      position: relative;
      z-index: 1;
      margin-top: 22px;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .mini-panel {
      padding: 18px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .mini-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 18px;
    }

    .mini-header strong {
      font-size: 15px;
    }

    .mini-stat {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .mini-stat:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }

    .mini-stat .label {
      color: var(--muted);
      font-size: 13px;
    }

    .mini-stat .value {
      font-weight: 800;
      font-size: 1.1rem;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 24px;
    }

    .stat-card {
      padding: 18px 18px 16px;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: "";
      position: absolute;
      inset: 0 auto auto 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, var(--blue), var(--cyan));
    }

    .stat-card .top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .stat-card .num {
      font-size: clamp(1.6rem, 2vw, 2.2rem);
      font-weight: 800;
      line-height: 1;
      margin-bottom: 10px;
    }

    .stat-card .trend {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--green);
      font-size: 12px;
      font-weight: 700;
    }

    .dash-grid {
      display: grid;
      grid-template-columns: 1.55fr 0.95fr;
      gap: 22px;
      margin-bottom: 24px;
    }

    .chart-panel {
      padding: 20px 20px 16px;
    }

    .panel-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 20px;
    }

    .panel-head h3 {
      margin: 0;
      font-size: 1.05rem;
    }

    .panel-head .period {
      color: var(--muted);
      font-size: 12px;
      border: 1px solid var(--border);
      background: rgba(255,255,255,0.02);
      padding: 7px 10px;
      border-radius: 999px;
    }

    .chart {
      height: 220px;
      display: flex;
      align-items: flex-end;
      gap: 12px;
      padding: 16px 8px 8px;
      border-radius: 16px;
      background:
        linear-gradient(to top, rgba(57,191,255,0.06), rgba(57,191,255,0.01)),
        rgba(255,255,255,0.01);
      border: 1px solid rgba(255,255,255,0.04);
    }

    .bar-group {
      flex: 1;
      display: flex;
      align-items: flex-end;
      justify-content: center;
      height: 100%;
      position: relative;
    }

    .bar {
      width: 100%;
      max-width: 36px;
      min-height: 12px;
      border-radius: 12px 12px 0 0;
      background: linear-gradient(180deg, var(--blue), var(--cyan));
      box-shadow: 0 18px 26px rgba(57,191,255,0.2);
    }

    .bar.alt {
      background: linear-gradient(180deg, var(--purple), var(--blue));
    }

    .bar-group span {
      position: absolute;
      bottom: -18px;
      left: 50%;
      transform: translateX(-50%);
      color: var(--muted);
      font-size: 11px;
    }

    .activity {
      padding: 20px;
    }

    .activity-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 10px;
    }

    .activity-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 12px;
      border: 1px solid rgba(255,255,255,0.04);
      border-radius: 14px;
      background: rgba(255,255,255,0.02);
    }

    .activity-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .activity-icon {
      width: 34px;
      height: 34px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      font-size: 14px;
      font-weight: 800;
    }

    .activity-icon.blue { background: rgba(57,191,255,0.12); color: var(--blue); }
    .activity-icon.green { background: rgba(66,211,146,0.12); color: var(--green); }
    .activity-icon.yellow { background: rgba(255,200,87,0.12); color: var(--yellow); }

    .activity-copy small {
      color: var(--muted);
      display: block;
      margin-top: 2px;
    }

    .activity-time {
      color: var(--muted);
      font-size: 12px;
      white-space: nowrap;
    }

    .bottom-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 22px;
    }

    .assistant-panel {
      padding: 20px;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .assistant-box {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 16px;
      padding: 16px;
    }

    .assistant-box h4 {
      margin: 0 0 10px;
      font-size: 0.96rem;
    }

    .assistant-box p {
      margin: 0;
      color: var(--muted);
      line-height: 1.7;
    }

    .prompt {
      display: flex;
      gap: 10px;
      padding: 12px 12px 12px 14px;
      background: rgba(255,255,255,0.02);
      border: 1px solid var(--border);
      border-radius: 14px;
    }

    .prompt input {
      flex: 1;
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 15px;
    }

    .prompt input::placeholder {
      color: var(--muted);
    }

    .prompt button {
      border-radius: 10px;
      padding: 10px 14px;
      background: linear-gradient(135deg, var(--blue), var(--cyan));
      color: #04131d;
      font-weight: 800;
    }

    .quick-card {
      padding: 18px;
    }

    .quick-list {
      display: grid;
      gap: 12px;
      margin-top: 18px;
    }

    .quick-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 12px;
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 12px;
      background: rgba(255,255,255,0.02);
    }

    .quick-item strong {
      display: block;
      margin-bottom: 4px;
      font-size: 14px;
    }

    .quick-item small {
      color: var(--muted);
    }

    @media (max-width: 1100px) {
      .hero, .dash-grid, .bottom-grid {
        grid-template-columns: 1fr;
      }
      .stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 860px) {
      .app {
        grid-template-columns: 1fr;
      }

      .sidebar {
        padding-bottom: 10px;
      }

      body {
        overflow: auto;
      }

      .main {
        height: auto;
      }

      .topbar {
        padding-inline: 18px;
      }

      .content {
        padding: 20px 18px 30px;
      }

      .stats {
        grid-template-columns: 1fr;
      }

      .topbar {
        flex-wrap: wrap;
        height: auto;
      }
    }

    /* CAPRI chat + ADM */
    .chat-toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
    .chat-local-status{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:12px}
    .chat-local-status i{width:8px;height:8px;border-radius:50%;background:var(--yellow);display:inline-block;box-shadow:0 0 10px currentColor}
    .chat-local-status.connected i{background:var(--green)}
    .chat-tools{display:flex;gap:8px;flex-wrap:wrap}
    .chat-tools .ghost-btn{padding:8px 11px;font-size:12px}
    .chat-messages{height:290px;overflow:auto;display:flex;flex-direction:column;gap:12px;padding:14px;background:rgba(3,10,19,.35);border:1px solid var(--border);border-radius:14px}
    .chat-message{max-width:88%;padding:11px 13px;border-radius:13px;line-height:1.55;overflow-wrap:anywhere}
    .chat-message p{margin:5px 0 0;white-space:pre-wrap}
    .chat-message b{font-size:11px;letter-spacing:.06em;color:var(--cyan)}
    .assistant-message{align-self:flex-start;background:var(--panel-strong);border:1px solid rgba(117,232,255,.12)}
    .user-message{align-self:flex-end;background:rgba(57,191,255,.14);border:1px solid rgba(57,191,255,.25)}
    .user-message b{color:var(--blue)}
    .chat-footnote{font-size:11px;color:var(--muted)}
    .chat-footnote code{color:var(--cyan);background:rgba(117,232,255,.08);padding:2px 5px;border-radius:5px}
    .prompt input{min-width:0;outline:none}
    .prompt button:disabled{opacity:.55;cursor:wait}
    .adm-overlay{position:fixed;inset:0;background:rgba(0,5,12,.82);backdrop-filter:blur(9px);display:none;align-items:center;justify-content:center;padding:18px;z-index:9999}
    .adm-overlay.open{display:flex}
    .adm-card{width:min(540px,100%);max-height:90vh;overflow:auto;background:#101b2a;border:1px solid rgba(117,232,255,.25);border-radius:20px;padding:22px;box-shadow:0 25px 90px rgba(0,0,0,.55)}
    .adm-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:18px}
    .adm-head h2{margin:0 0 6px;font-size:20px;color:var(--text)}
    .adm-head p,.adm-help{margin:0;color:var(--muted);font-size:12px;line-height:1.6}
    .adm-close{background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--border);border-radius:10px;padding:8px 11px;cursor:pointer}
    .adm-field{display:grid;gap:7px;margin:14px 0}
    .adm-field label{font-size:13px;font-weight:700;color:var(--text)}
    .adm-field input,.adm-field textarea,.adm-field select{width:100%;padding:12px;border-radius:10px;border:1px solid var(--border);background:#091321;color:var(--text);outline:none}
    .adm-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:16px}
    .adm-warning{margin-top:14px;padding:12px;border:1px solid rgba(255,200,87,.25);background:rgba(255,200,87,.07);border-radius:11px;color:#f5d58a;font-size:12px;line-height:1.6}
    .adm-msg{min-height:18px;color:var(--cyan);font-size:12px;margin-top:10px}
    .history-list{display:grid;gap:8px;margin-top:12px}
    .history-entry{padding:10px;border:1px solid var(--border);border-radius:10px;background:rgba(255,255,255,.025);font-size:12px;color:var(--muted)}
    .history-entry strong{display:block;color:var(--text);margin-bottom:4px}
    @media(max-width:600px){.chat-messages{height:250px}.chat-message{max-width:96%}.adm-card{padding:17px}}

  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <div class="logo">
        <div class="logo-icon">C</div>
        <div class="logo-text">
          <strong>CAPRI</strong>
          <small>IA SYSTEM</small>
        </div>
      </div>

      <nav class="nav-group">
        <button class="side-btn active">
          <span class="left">
            <span class="icon">◫</span>
            <span>Dashboard</span>
          </span>
          <span class="badge">3</span>
        </button>

        <button class="side-btn">
          <span class="left">
            <span class="icon">✦</span>
            <span>Fluxos</span>
          </span>
        </button>

        <button class="side-btn">
          <span class="left">
            <span class="icon">◌</span>
            <span>Agentes</span>
          </span>
        </button>

        <button class="side-btn">
          <span class="left">
            <span class="icon">◎</span>
            <span>Relatórios</span>
          </span>
        </button>

        <button class="side-btn">
          <span class="left">
            <span class="icon">⚑</span>
            <span>Configuração</span>
          </span>
        </button>
      </nav>

      <div class="sidebar-label">Operações</div>

      <nav class="nav-group">
        <button class="side-btn">
          <span class="left">
            <span class="icon">⎈</span>
            <span>Deploy</span>
          </span>
        </button>

        <button class="side-btn">
          <span class="left">
            <span class="icon">☰</span>
            <span>Análises</span>
          </span>
        </button>
      </nav>

      <div class="sidebar-bottom">
        <div class="status">
          <span>Sistema online</span>
          <span class="status-dot"></span>
        </div>
        <div class="status">
          <span>Latência</span>
          <strong>32ms</strong>
        </div>
      </div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div class="topbar-left">
          <div class="title-wrap">
            <h1>Dashboard CAPRI IA</h1>
            <small>Visão geral do ambiente operacional</small>
          </div>
        </div>

        <div class="topbar-actions">
