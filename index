  <div class="adm-overlay" id="admOverlay" role="dialog" aria-modal="true" aria-labelledby="admTitle">
    <section class="adm-card">
      <div class="adm-head">
        <div><h2 id="admTitle">⌘ CENTRAL ADM — CAPRI</h2><p>Configurações desta instalação</p></div>
        <button class="adm-close" type="button" id="admClose" aria-label="Fechar">✕</button>
      </div>
      <div id="admLoginArea">
        <p class="adm-help" id="admLoginDescription">Digite a senha administrativa para abrir as configurações.</p>
        <div class="adm-field"><label for="admPassword">Senha ADM</label><input id="admPassword" type="password" autocomplete="current-password" placeholder="Senha administrativa"></div>
        <div class="adm-actions"><button class="primary-btn" type="button" id="admLoginBtn">Entrar</button></div>
      </div>
      <div id="admSettingsArea" hidden>
        <div class="adm-field"><label for="groqKey">Chave da API Groq</label><input id="groqKey" type="password" autocomplete="off" placeholder="Cole sua chave Groq aqui"></div>
        <div class="adm-field"><label for="groqModel">Modelo</label>
          <select id="groqModel">
            <option value="llama-3.3-70b-versatile">Llama 3.3 70B Versatile</option>
            <option value="llama-3.1-8b-instant">Llama 3.1 8B Instant</option>
          </select>
        </div>
        <div class="adm-field"><label for="capriPersonality">Personalidade da CAPRI</label><textarea id="capriPersonality" rows="3">Você é CAPRI, uma assistente virtual inteligente, confiante, expressiva, espirituosa e direta. Fale em português brasileiro natural. Adapte o tom ao jeito de falar do usuário, seja útil e honesta. Nunca invente que executou ações.</textarea></div>
        <div class="adm-actions">
          <button class="primary-btn" type="button" id="saveAdmBtn">Salvar nesta aba</button>
          <button class="ghost-btn" type="button" id="testApiBtn">Testar conexão</button>
          <button class="ghost-btn" type="button" id="clearKeyBtn">Apagar chave</button>
        </div>
        <p class="adm-help" style="margin-top:12px">A chave fica somente na sessão atual do navegador e é apagada quando a aba/sessão termina. Não é gravada no HTML nem no GitHub.</p>
      </div>
      <div class="adm-warning"><strong>Importante:</strong> esta é uma versão estática do GitHub Pages. Ao chamar a Groq diretamente pelo navegador, a chave pode ser vista por alguém com acesso às ferramentas do navegador ou ao tráfego da sessão. A senha ADM também é apenas uma barreira visual, não uma segurança real. Para proteger a chave de verdade, será necessário um backend.</div>
      <div class="adm-msg" id="admMessage" role="status"></div>
    </section>
  </div>

  <script>
    const $ = (id) => document.getElementById(id);
    const chatStoreKey = "capri_chat_history_v1";
    const adminHashKey = "capri_admin_hash_v1";
    const keyStore = "capri_groq_key_session";
    const modelStore = "capri_groq_model_session";
    const personalityStore = "capri_personality_session";
    let messages = [];
    let adminUnlocked = false;
    let busy = false;

    function safeRead(key, fallback) {
      try { const value = JSON.parse(localStorage.getItem(key)); return value ?? fallback; }
      catch { return fallback; }
    }
    function saveHistory() {
      try { localStorage.setItem(chatStoreKey, JSON.stringify(messages.slice(-80))); }
      catch { setStatus("Armazenamento local indisponível."); }
    }
    function setStatus(text, connected = false) {
      $("connectionLabel").textContent = text;
      $("capriStatus").textContent = text;
      $("connectionLabel").parentElement.classList.toggle("connected", connected);
    }
    function renderMessages() {
      const area = $("chatMessages");
      area.innerHTML = "";
      if (!messages.length) {
        const welcome = document.createElement("div");
        welcome.className = "chat-message assistant-message";
        const name = document.createElement("b"); name.textContent = "CAPRI";
        const p = document.createElement("p"); p.textContent = "Conversa limpa. Pode mandar sua mensagem!";
        welcome.append(name, p); area.append(welcome);
      }
      messages.forEach(item => {
        const bubble = document.createElement("div");
        bubble.className = "chat-message " + (item.role === "user" ? "user-message" : "assistant-message");
        const name = document.createElement("b");
        name.textContent = item.role === "user" ? "VOCÊ" : "CAPRI";
        const p = document.createElement("p"); p.textContent = item.content;
        bubble.append(name, p); area.append(bubble);
      });
      area.scrollTop = area.scrollHeight;
    }
    function addMessage(role, content) {
      messages.push({role, content, at: new Date().toISOString()});
      saveHistory(); renderMessages();
    }
    function getApiKey() { return sessionStorage.getItem(keyStore) || ""; }
    function getModel() { return sessionStorage.getItem(modelStore) || "llama-3.3-70b-versatile"; }
    function getPersonality() {
      return sessionStorage.getItem(personalityStore) ||
        "Você é CAPRI, uma assistente virtual inteligente, confiante, expressiva, espirituosa e direta. Fale em português brasileiro natural. Adapte o tom ao jeito de falar do usuário, seja útil e honesta. Nunca invente que executou ações.";
    }
    function updateConnection() {
      setStatus(getApiKey() ? "Chave Groq configurada nesta sessão" : "Aguardando configuração em /ADM", !!getApiKey());
    }
    function openAdm() {
      $("admOverlay").classList.add("open");
      $("admMessage").textContent = "";
      $("admLoginArea").hidden = adminUnlocked;
      $("admSettingsArea").hidden = !adminUnlocked;
      $("admLoginDescription").textContent = localStorage.getItem(adminHashKey)
        ? "Digite a senha administrativa para continuar."
        : "Primeiro acesso: crie uma senha administrativa para esta instalação.";
      if (adminUnlocked) {
        $("groqKey").value = getApiKey();
        $("groqModel").value = getModel();
        $("capriPersonality").value = getPersonality();
      } else {
        $("admPassword").value = "";
        $("admPassword").focus();
      }
    }
    function closeAdm() { $("admOverlay").classList.remove("open"); }
    async function hashPassword(value) {
      const bytes = new TextEncoder().encode(value);
      const digest = await crypto.subtle.digest("SHA-256", bytes);
      return Array.from(new Uint8Array(digest)).map(b => b.toString(16).padStart(2,"0")).join("");
    }
    async function loginAdm() {
      const pass = $("admPassword").value;
      if (pass.length < 6) { $("admMessage").textContent = "Use uma senha com pelo menos 6 caracteres."; return; }
      const existing = localStorage.getItem(adminHashKey);
      const hash = await hashPassword(pass);
      if (!existing) {
        localStorage.setItem(adminHashKey, hash);
        $("admMessage").textContent = "Senha ADM criada neste navegador.";
      } else if (existing !== hash) {
        $("admMessage").textContent = "Senha incorreta.";
        return;
      }
      adminUnlocked = true;
      $("admLoginArea").hidden = true;
      $("admSettingsArea").hidden = false;
      $("groqKey").value = getApiKey();
      $("groqModel").value = getModel();
      $("capriPersonality").value = getPersonality();
    }
    function saveAdm() {
      const key = $("groqKey").value.trim();
      if (key) sessionStorage.setItem(keyStore, key);
      else sessionStorage.removeItem(keyStore);
      sessionStorage.setItem(modelStore, $("groqModel").value);
      sessionStorage.setItem(personalityStore, $("capriPersonality").value.trim());
      updateConnection();
      $("admMessage").textContent = "Configurações salvas nesta sessão do navegador.";
    }
    async function testApi() {
      saveAdm();
      const key = getApiKey();
      if (!key) { $("admMessage").textContent = "Cole uma chave Groq antes de testar."; return; }
      $("testApiBtn").disabled = true;
      $("admMessage").textContent = "Testando conexão...";
      try {
        const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
          method: "POST",
          headers: {"Content-Type":"application/json","Authorization":"Bearer "+key},
          body: JSON.stringify({model:getModel(),messages:[{role:"user",content:"Responda somente: conexão OK"}],max_tokens:20})
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error?.message || ("HTTP "+response.status));
        $("admMessage").textContent = "Conexão funcionando! CAPRI recebeu: " + (data.choices?.[0]?.message?.content || "resposta recebida");
      } catch (error) {
        $("admMessage").textContent = "Falha no teste: " + error.message;
      } finally { $("testApiBtn").disabled = false; }
    }
    async function sendMessage(text) {
      if (busy || !text.trim()) return;
      const raw = text.trim();
      if (raw.toLowerCase() === "/adm") { addMessage("user", raw); openAdm(); return; }
      if (raw.toLowerCase() === "/limpar") { messages = []; saveHistory(); renderMessages(); return; }
      if (raw.toLowerCase() === "/exportar") { exportHistory(); return; }
      addMessage("user", raw);
      const key = getApiKey();
      if (!key) {
        addMessage("assistant", "Ainda não estou conectada à IA. Digite /ADM, entre na área administrativa e configure sua chave Groq para ativar minhas respostas.");
        return;
      }
      busy = true; $("sendBtn").disabled = true; $("sendBtn").textContent = "…";
      const pending = document.createElement("div");
      pending.className = "chat-message assistant-message"; pending.id = "capriPending";
      const pendingName = document.createElement("b"); pendingName.textContent = "CAPRI";
      const pendingText = document.createElement("p"); pendingText.textContent = "Estou pensando...";
      pending.append(pendingName,pendingText); $("chatMessages").append(pending);
      $("chatMessages").scrollTop = $("chatMessages").scrollHeight;
      try {
        const context = messages.slice(-18).map(m => ({role:m.role,content:m.content}));
        const response = await fetch("https://api.groq.com/openai/v1/chat/completions", {
          method:"POST",
          headers:{"Content-Type":"application/json","Authorization":"Bearer "+key},
          body:JSON.stringify({
            model:getModel(),
            messages:[{role:"system",content:getPersonality()},...context],
            temperature:0.75,
            max_tokens:900
          })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error?.message || ("HTTP "+response.status));
        const answer = data.choices?.[0]?.message?.content?.trim();
        if (!answer) throw new Error("A API não retornou uma resposta.");
        $("capriPending")?.remove();
        addMessage("assistant",answer);
      } catch(error) {
        $("capriPending")?.remove();
        addMessage("assistant","Não consegui obter uma resposta da Groq: "+error.message);
      } finally {
        busy = false; $("sendBtn").disabled = false; $("sendBtn").textContent = "Enviar";
        $("chatInput").focus();
      }
    }
    function exportHistory() {
      const blob = new Blob([JSON.stringify({project:"CAPRI IA",exportedAt:new Date().toISOString(),messages},null,2)],{type:"application/json"});
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a"); a.href=url; a.download="capri-historico.json"; a.click();
      URL.revokeObjectURL(url);
    }
    function showHistory() {
      const history = safeRead(chatStoreKey, []);
      const summary = history.length ? history.slice(-12).map(m => (m.role==="user"?"Você: ":"CAPRI: ")+m.content.slice(0,150)).join("\n\n") : "Nenhuma mensagem salva ainda.";
      alert("HISTÓRICO RECENTE\n\n"+summary);
    }

    $("chatForm").addEventListener("submit", event => {
      event.preventDefault();
      const value = $("chatInput").value;
      $("chatInput").value = "";
      sendMessage(value);
    });
    $("admClose").addEventListener("click",closeAdm);
    $("admOverlay").addEventListener("click",event=>{if(event.target===$("admOverlay"))closeAdm();});
    $("admLoginBtn").addEventListener("click",loginAdm);
    $("admPassword").addEventListener("keydown",event=>{if(event.key==="Enter")loginAdm();});
    $("saveAdmBtn").addEventListener("click",saveAdm);
    $("testApiBtn").addEventListener("click",testApi);
    $("clearKeyBtn").addEventListener("click",()=>{$("groqKey").value="";sessionStorage.removeItem(keyStore);updateConnection();$("admMessage").textContent="Chave apagada desta sessão.";});
    $("newChatBtn").addEventListener("click",()=>{messages=[];saveHistory();renderMessages();});
    $("historyBtn").addEventListener("click",showHistory);

    document.querySelectorAll(".side-btn").forEach(button=>{
      button.addEventListener("click",()=>{
        document.querySelectorAll(".side-btn").forEach(btn=>btn.classList.remove("active"));
        button.classList.add("active");
      });
    });
    document.querySelectorAll(".topbar-actions .ghost-btn").forEach(button=>button.addEventListener("click",exportHistory));
    document.querySelectorAll(".topbar-actions .primary-btn").forEach(button=>button.addEventListener("click",()=>{$("chatInput").focus();$("chatInput").scrollIntoView({behavior:"smooth",block:"center"});}));
    document.querySelectorAll(".welcome-actions .primary-btn").forEach(button=>button.addEventListener("click",()=>{$("chatInput").focus();$("chatInput").scrollIntoView({behavior:"smooth",block:"center"});}));
    document.querySelectorAll(".welcome-actions .ghost-btn").forEach(button=>button.addEventListener("click",showHistory));

    messages = safeRead(chatStoreKey, []);
    renderMessages();
    updateConnection();
  </script>
